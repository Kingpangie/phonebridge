<UserControl x:Class="PhoneBridge.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
      <TextBlock Text="Connected devices and quick status" FontSize="13" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,16"/>

      <WrapPanel>
        <Border Style="{StaticResource Card}" Width="480" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="Android devices" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ItemsControl x:Name="AndroidList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <Grid>
                      <StackPanel>
                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource SubtleBrush}">
                          <Run Text="{Binding AndroidVersion, Mode=OneWay}"/> · battery <Run Text="{Binding BatteryLevel, Mode=OneWay}"/> · storage <Run Text="{Binding StorageUsed, Mode=OneWay}"/> / <Run Text="{Binding StorageTotal, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Background="#DCFCE7" Padding="8,3">
                        <TextBlock Text="ready" FontSize="10" Foreground="#166534"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="AndroidEmpty" Text="No Android device detected. Enable USB debugging and allow the PC." FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,4"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Width="480" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="iPhone / iPad" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ItemsControl x:Name="IosList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                      <TextBlock Text="Apple Mobile Device detected" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="IosHint" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,4"/>
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
