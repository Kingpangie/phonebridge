<UserControl x:Class="PhoneBridge.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Tools" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
    <TextBlock x:Name="DeviceLabel" Text="No device" FontSize="13" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,16"/>

    <WrapPanel>
      <Border Style="{StaticResource Card}" Width="320" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Screenshot" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Capture the phone screen and save a PNG to this PC." FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Capture screenshot" HorizontalAlignment="Left" Click="Screenshot_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Width="320" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Reboot" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Restart the phone, or boot into recovery / bootloader mode." FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="Restart" Click="Reboot_Click" Tag="normal"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Recovery" Margin="8,0,0,0" Click="Reboot_Click" Tag="recovery"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Bootloader" Margin="8,0,0,0" Click="Reboot_Click" Tag="bootloader"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Width="320" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Disk info" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="DiskInfo" Text="—" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Refresh" HorizontalAlignment="Left" Click="RefreshInfo_Click"/>
        </StackPanel>
      </Border>
    </WrapPanel>
  </StackPanel>
</UserControl>
