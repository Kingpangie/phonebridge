<UserControl x:Class="PhoneBridge.Views.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Export" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
    <TextBlock x:Name="DeviceLabel" Text="No device" FontSize="13" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,16"/>

    <WrapPanel>
      <Border Style="{StaticResource Card}" Width="320" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Contacts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Export names, phone numbers and emails to a CSV file." FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Export contacts…" HorizontalAlignment="Left" Click="Contacts_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Width="320" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Messages (SMS)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Export your SMS history with dates and directions to CSV." FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Export SMS…" HorizontalAlignment="Left" Click="Sms_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Width="320" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Call log" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Export calls with direction, duration and contact names to CSV." FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Export call log…" HorizontalAlignment="Left" Click="Calls_Click"/>
        </StackPanel>
      </Border>
    </WrapPanel>
  </StackPanel>
</UserControl>
